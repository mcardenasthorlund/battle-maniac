{
  "name": "battle-royale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w @br/server",
    "dev:client": "npm run dev -w @br/client",
    "build": "npm run build -w @br/client",
    "start": "npm run start -w @br/server",
    "bots": "tsx tools/bot/src/index.ts",
    "simtest": "tsx apps/server/src/dev/simtest.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
